[resource]
script = ExtResource("1")
gear_id = &"dampening_wrap"
display_name = "Dampening Wrap"
description = "Legitimate Wickwork vibration-control equipment (canon §65, Approved — Secrecy). Reduces tool vibration/noise — for worker safety and structural stability, and naturally also useful for illicit excavation. Quiets upward digs by one level."
kind = &"approved"
category = &"utility"
capacity_cost = 1
effects = {
"quiet_dig_level": 1.0
}
order_district = &"wickwork"
order_tallies = 5
order_output = 1.0
order_min_trust = &"relied_on"
